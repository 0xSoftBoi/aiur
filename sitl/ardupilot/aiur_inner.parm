# Overlay for aiur_s2.parm when scripts/aiur_inner.lua is installed
# (run_sitl.sh INNER=1).  Kept separate so the stock-Rover results stay
# reproducible from aiur_s2.parm alone.

# An airspeed sensor, so the script can enforce the airspeed limit.
# 100 = SITL: the plant sends true airspeed in the JSON "airspeed" field.
ARSPD_TYPE 100
ARSPD_USE 1
# SITL models a pitot: differential pressure plus +/-2 Pa of noise
# (SIM_ARSPD_RND default 2).  At 20 km and 6 m/s the whole signal is 1.6 Pa
# (0.7 Pa at 4 m/s), so the default noise is larger than the signal.  That
# is the hardware finding - no pitot or differential-pressure sensor
# resolves this - and the flight sensor has to
# be an anemometer (ultrasonic or hot-film) presented to ArduPilot as an
# airspeed backend.  Noise is set to zero here to stand in for one; its real
# error model is not simulated.
SIM_ARSPD_RND 0
# No pre-flight zero-airspeed calibration of a sensor that is never at rest.
ARSPD_SKIP_CAL 1
# The speed-ratio autocal and the "airspeed vs wind" health checks are for
# aeroplanes.
ARSPD_AUTOCAL 0
ARSPD_OPTIONS 0
ARSPD_WIND_MAX 0
# The inner loop asks more of the scripting VM (50 Hz).
SCR_VM_I_COUNT 100000
# On a failsafe prefer LOITER, else HOLD; the script stays active in both
# (AIN_FS_HOLD 1) so the motor is not cut.
FS_ACTION 6
